%Vecteurs
%$\vect{u}[x][y][z]$


\newcommand{\covec}[2]{\begin{pmatrix}#1\\#2\end{pmatrix}}
%Limites
%$\Lim[< ou >]{variable}{point}$
%$\Lim{n}{+\infty}$
%$\Lim[<]{x}{2}$
\newcommandx{\Lim}[3][1]{\def\temp{#1}\ifdefempty{\temp}
    {\lim_{#2 \to #3}}
    {\lim_{\substack{#2 \to #3\\#2~#1~#3}}}
}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%Vecteur colonne
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%


%%%%%%%%%%%%%%%%
\newcommand{\vectcord}[4]{\vect{#1}\begin{pmatrix}#2\\#3\\#4\end{pmatrix}}
%Divers
%%%%%%%%%%%%%%%%%
\newcommand{\prodscal}[2]{#1\cdot#2} %Pas super utile....
\DeclarePairedDelimiter{\abs}{\lvert}{\rvert}
\DeclarePairedDelimiter{\norme}{\lVert}{\rVert}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%System à 2 équations
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\systdeux}[2]{\begin{cases}#1 \\ #2\end{cases}}
%Groupement et accolade
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\groupe}[2]{
    \left.\begin{array}{l}#1\hfill\null \\
        \\
        #2\hfill\null
    \end{array}\right\} 
}
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%x1 et x2 après Delta...
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\xda}{
    x_1=\frac{-b+\sqrt{\Delta}}{2a}
}

\newcommand{\xdb}{
    x_2=\frac{-b-\sqrt{\Delta}}{2a}
}


